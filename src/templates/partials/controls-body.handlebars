{{!-- Controls modal body - re-rendered on every open (see App.openContentModal)
     so key labels stay in sync with the current bindings. --}}
<table class="controls-bindings-table">
    <thead>
        <tr>
            <th colspan="2">Left hand</th>
            <th colspan="2">Right hand</th>
        </tr>
    </thead>
    <tbody>
        <tr class="controls-bindings-keys">
            <td><span class="keycap">{{leftSelf}}</span></td>
            <td><span class="keycap">{{leftCross}}</span></td>
            <td><span class="keycap">{{rightCross}}</span></td>
            <td><span class="keycap">{{rightSelf}}</span></td>
        </tr>
        <tr class="controls-bindings-labels">
            <td>Self throw</td>
            <td>Crossing throw</td>
            <td>Crossing throw</td>
            <td>Self throw</td>
        </tr>
    </tbody>
</table>
<p class="controls-description">
    A &ldquo;self throw&rdquo; is a throw to the same hand, while a &ldquo;crossing throw&rdquo; (you guessed it!) crosses to the other hand.
    <br><br>
    To increase the height of your throw, {{heightControlPhrase}}. (You can change how height control works in the <span class="controls-settings-ref"><span class="material-symbols-outlined controls-settings-icon" aria-hidden="true">settings</span> Settings</span> menu.)
</p>
