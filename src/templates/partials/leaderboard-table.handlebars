{{!-- Scores modal body: the shared score-table plus a reset action - kept as
     its own partial (not just inlined in leaderboard-modal.handlebars) so
     App.openContentModal can re-render just this part with fresh `scores`
     every time the modal's reopened, without touching the surrounding modal
     shell/its event bindings. --}}
{{> score-table scores=scores}}
<button type="button" class="text-button modal-footer-button" data-action="leaderboard-reset">Reset all scores</button>
