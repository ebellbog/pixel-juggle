{{!-- The leaderboard's actual score table (see .leaderboard-table in
     index.less) - a separate partial (not just inline in
     leaderboard-modal.handlebars) so App.openContentModal can re-render just
     this part with fresh `scores` data every time the modal's reopened,
     without touching the surrounding modal shell/its event bindings. --}}
<div class="leaderboard-table-wrap" tabindex="0">
    <table class="leaderboard-table">
        <thead>
            <tr>
                <th>Player</th>
                <th>Pattern</th>
                <th>Difficulty</th>
                <th>Score</th>
            </tr>
        </thead>
        <tbody>
            {{#each scores}}
            <tr>
                <td>{{player}}</td>
                <td>{{pattern}}</td>
                <td>{{difficulty}}</td>
                <td>{{score}}</td>
            </tr>
            {{else}}
            <tr>
                <td colspan="4" class="leaderboard-empty">No scores yet.</td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
<button type="button" class="text-button modal-footer-button" data-action="leaderboard-reset">Reset all scores</button>
